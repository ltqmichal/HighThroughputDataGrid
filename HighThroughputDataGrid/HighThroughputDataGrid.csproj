<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWpf>true</UseWpf>
    <RootNamespace>HighThroughputDataGrid</RootNamespace>
    <AssemblyName>HighThroughputDataGrid</AssemblyName>
    <StartupObject>HighThroughputDataGrid.App</StartupObject>
    <ApplicationIcon>SX.ico</ApplicationIcon>

    <!-- Optional, aber empfohlen für modernen Code -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>

  <ItemGroup>
    <!-- System.Windows.Interactivity gibt es in .NET 10 nicht mehr. 
         Es wurde durch das offizielle Microsoft.Xaml.Behaviors.Wpf Paket ersetzt -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />

    <!-- Falls Sie System.Configuration für die App.config benötigen -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verhindert, dass das Icon fälschlicherweise doppelt eingebunden wird -->
    <Resource Remove="SX.ico" />
  </ItemGroup>

</Project>
